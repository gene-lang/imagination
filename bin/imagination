#!/bin/sh
# Bootstrap Gene; the application itself is written in Gene.
imagination_package_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if ! command -v gene >/dev/null 2>&1; then
  echo "gene not found on PATH (add the Gene checkout's bin directory to PATH)" >&2
  exit 127
fi
exec gene run --package-root "$imagination_package_dir" "$imagination_package_dir/src/main.gene" -- "$@"
